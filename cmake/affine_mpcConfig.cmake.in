@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Eigen3 REQUIRED)
# A static affine_mpc installs the OSQP it was built with as affine_mpc_osqp
if(@AFFINE_MPC_CONFIG_NEEDS_OSQP@)
  find_dependency(osqp REQUIRED)
endif()
# A static library carries its private ZLIB link to consumers
if(@AFFINE_MPC_CONFIG_NEEDS_ZLIB@)
  find_dependency(ZLIB)
endif()
if(@AFFINE_MPC_CONFIG_NEEDS_DAQP@)
  find_dependency(daqp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components(@PROJECT_NAME@)
