@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Eigen3 REQUIRED)
# OSQP is private: a shared affine_mpc links it itself, and a static one
# installs the fetched OSQP as affine_mpc_osqp. Only a static affine_mpc built
# with an osqp::osqp target from a parent project passes that target on.
if(@AFFINE_MPC_CONFIG_NEEDS_OSQP@)
  find_dependency(osqp)
endif()
# A static library carries its private ZLIB link to consumers
if(@AFFINE_MPC_CONFIG_NEEDS_ZLIB@)
  find_dependency(ZLIB)
endif()
if(@AFFINE_MPC_CONFIG_NEEDS_DAQP@)
  find_dependency(daqp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components(@PROJECT_NAME@)
